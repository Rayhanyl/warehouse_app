# TEMPLATE: frontend lokal -> backend SERVER DEVELOPMENT.
#
#   Copy-Item .env.dev-server.example .env.dev-server
#   npm run dev:server
#
# `.env.dev-server` tidak di-commit. Isi URL backend server development tim Anda.
# Request /api/v1 tetap lewat proxy Vite (tanpa CORS); backend tidak perlu
# mendaftarkan origin lokal Anda.
VITE_API_BASE_URL=/api/v1
VITE_DEV_PROXY_TARGET=https://<host-backend-server-development>

# Mengarahkan ke backend PRODUCTION diblokir secara default. Hanya aktifkan bila
# diizinkan untuk kebutuhan khusus, dan lakukan di berkas `.env.dev-server.local`:
# VITE_ALLOW_PRODUCTION_PROXY=true
