# ==============================================================================
# Variabel Lingkungan Frontend WMS (Vite)
# ==============================================================================

# Opsi 1: Development Lokal via Vite Proxy (Rekomendasi - Bebas CORS & Bebas Third-Party Cookie block)
VITE_API_BASE_URL=/api/v1

# Opsi 2: Direct Hit ke Backend Server Production (Perlu CORS & HTTPS)
# VITE_API_BASE_URL=https://api-jkstok.my.id

# Opsi 3: Backend Lokal (jika backend dijalankan di PC lokal pada port 8000)
# VITE_API_BASE_URL=http://localhost:8000
