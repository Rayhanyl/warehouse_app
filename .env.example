# ==============================================================================
# TEMPLATE VARIABEL LINGKUNGAN FRONTEND (Vite)
#
# Urutan prioritas Vite (tinggi -> rendah):
#   variabel OS > .env.[mode].local > .env.[mode] > .env.local > .env
# Berkas yang di-commit: `.env.development` (default aman -> backend lokal),
# `.env.example`, `.env.dev-server.example`. Berkas `*.local` dan `.env.dev-server`
# tidak pernah di-commit.
#
# Skenario (pilih salah satu; panduan lengkap: api_warehouse_app/docs/core/environment-setup-guide.md):
#   1. Backend lokal         : npm run dev          (memakai .env.development)
#   2. Backend server dev    : npm run dev:server   (memakai .env.dev-server)
#   3. Build production      : build-arg Docker VITE_API_BASE_URL (lihat Dockerfile)
# ==============================================================================

# URL API yang dipanggil browser. Nilai relatif `/api/v1` = lewat proxy Vite (disarankan).
# Nilai absolut (mis. https://api.contoh.com) = browser langsung ke backend (butuh CORS
# dan cookie lintas-origin); prefix /api/v1 ditambahkan otomatis bila belum ada.
VITE_API_BASE_URL=/api/v1

# Tujuan proxy Vite saat `npm run dev` (hanya dev server, tidak masuk bundle).
VITE_DEV_PROXY_TARGET=http://localhost:8000

# Izin eksplisit untuk mengarahkan dev server ke backend PRODUCTION (default: diblokir).
# VITE_ALLOW_PRODUCTION_PROXY=true
